{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/jarvis/browser",
  "rewrites": [
    { "source": "/anthropic/:path*", "destination": "https://jarvis-oeob.onrender.com/anthropic/:path*" },
    { "source": "/ollama/:path*",    "destination": "https://jarvis-oeob.onrender.com/ollama/:path*" },
    { "source": "/openai/:path*",    "destination": "https://jarvis-oeob.onrender.com/openai/:path*" },
    { "source": "/hermes/:path*",    "destination": "https://jarvis-oeob.onrender.com/hermes/:path*" },
    { "source": "/(.*)",             "destination": "/index.html" }
  ]
}
